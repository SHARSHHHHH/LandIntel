# Optional: enables AI-powered search/assistant features in the Research portal.
# Leave unset to run the app without them (all other features work fully offline).
GROQ_API_KEY=your_groq_api_key_here

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# JWT signing key for the Government/Admin portal (lib/gov/auth.ts).
# The code falls back to an insecure development default when this is unset — set it for any real deployment.
GOV_SECRET_KEY=

# Optional: email of an EXISTING user who should receive the admin role at startup.
# No user account is created. If unset, or the email matches no user, no admin is bootstrapped.
ADMIN_BOOTSTRAP_EMAIL=
